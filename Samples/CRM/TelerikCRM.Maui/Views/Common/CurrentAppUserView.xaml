<?xml version="1.0" encoding="utf-8" ?>
<telerik:RadContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                        xmlns:telerik="http://schemas.telerik.com/2022/xaml/maui"
                        xmlns:views="using:TelerikCRM.Maui.Views"
                        xmlns:vm="using:TelerikCRM.Maui.ViewModels"
                        x:Class="TelerikCRM.Maui.Views.CurrentAppUserView"
                        Padding="{OnPlatform MacCatalyst='0, 12', WinUI='0, 12'}">
    <telerik:RadContentView.ControlTemplate>
        <ControlTemplate>
            <Grid ColumnDefinitions="{OnPlatform MacCatalyst='32, *', WinUI='32, *'}"
                  ColumnSpacing="{OnPlatform MacCatalyst=8, WinUI=8}"
                  RowDefinitions="{OnPlatform MacCatalyst='Auto, Auto', WinUI='Auto, Auto'}"
                  HeightRequest="{OnPlatform Default=24, MacCatalyst=32, WinUI=32}"
                  HorizontalOptions="{OnPlatform Default=Start, MacCatalyst=End, WinUI=End}">
                <Image Grid.RowSpan="{OnPlatform MacCatalyst=2, WinUI=2}"
                       Source="current_user_image.png" />
                <Label Grid.Column="{OnPlatform MacCatalyst=1, WinUI=1}"
                       IsVisible="{OnPlatform Default=False, MacCatalyst=True, WinUI=True}"
                       Text="Eduard Wallace"
                       TextColor="{DynamicResource RadOnAppSurfaceColor}"
                       VerticalOptions="Start" />
                <Label Grid.Column="{OnPlatform MacCatalyst=1, WinUI=1}"
                       Grid.Row="{OnPlatform MacCatalyst=1, WinUI=1}"
                       IsVisible="{OnPlatform Default=False, MacCatalyst=True, WinUI=True}"
                       Text="Team Lead"
                       TextColor="{DynamicResource RadOnAppSurfaceColorAlpha60}"
                       FontSize="12"
                       VerticalOptions="End" />
            </Grid>
        </ControlTemplate>
    </telerik:RadContentView.ControlTemplate>
</telerik:RadContentView>