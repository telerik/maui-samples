<?xml version="1.0" encoding="utf-8" ?>
<views:BaseContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                       xmlns:telerik="http://schemas.telerik.com/2022/xaml/maui"
                       xmlns:views="clr-namespace:TelerikCRM.Maui.Views"
                       xmlns:vm="clr-namespace:TelerikCRM.Maui.ViewModels"
                       x:Class="TelerikCRM.Maui.Views.Desktop.ShippingView"
                       x:DataType="vm:ShippingViewModel"
                       ControlTemplate="{StaticResource TopLevelContentViewDesktopTemplate}"
                       Padding="{DynamicResource TopLevelViewPadding_Desktop}">
    <Grid x:Name="rootGrid"
          RowDefinitions="Auto, *"
          RowSpacing="{DynamicResource TopLevelViewTitleContentSpacing}">
        <Label Text="Shipping"
               Style="{DynamicResource NavigationViewItemTitleStyle}" />
        <telerik:RadBorder Grid.Row="1"
                           Style="{OnPlatform Default={x:Null}, MacCatalyst={DynamicResource NavigationViewItemBorderStyle}, WinUI={DynamicResource NavigationViewItemBorderStyle}}">
            <telerik:RadScheduler x:Name="shippingScheduler"
                                  AppointmentsSource="{Binding ShippingAppointments}"
                                  CurrentDate="{Binding CalendarDisplayDate}">
                <telerik:RadScheduler.ViewDefinitions>
                    <telerik:MultidayViewDefinition VisibleDays="5"
                                                    Title="5 Days"
                                                    IsCurrentTimeIndicatorVisible="True" />
                    <telerik:DayViewDefinition IsCurrentTimeIndicatorVisible="True" />
                    <telerik:WeekViewDefinition IsCurrentTimeIndicatorVisible="False"
                                                IsWeekendVisible="True" />
                    <telerik:MonthViewDefinition />
                </telerik:RadScheduler.ViewDefinitions>
            </telerik:RadScheduler>
        </telerik:RadBorder>
        <telerik:RadBusyIndicator Grid.RowSpan="2"
                                  IsVisible="{Binding IsBusy}"
                                  IsBusy="{Binding IsBusy}"
                                  Style="{StaticResource OpaqueBusyIndicatorStyle}" />
    </Grid>
</views:BaseContentView>