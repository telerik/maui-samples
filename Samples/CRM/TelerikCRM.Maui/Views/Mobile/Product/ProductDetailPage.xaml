<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage x:Name="Page"
                xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:telerik="http://schemas.telerik.com/2022/xaml/maui"
                xmlns:views="using:TelerikCRM.Maui.Views"
                xmlns:mobileViews="using:TelerikCRM.Maui.Views.Mobile"
                xmlns:vm="using:TelerikCRM.Maui.ViewModels"
                xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
                x:Class="TelerikCRM.Maui.Views.Mobile.ProductDetailPage"
                x:DataType="vm:ProductDetailViewModel"
                NavigationPage.HasNavigationBar="False"
                ios:Page.UseSafeArea="False">
    <views:BasePage.Resources>
        <Style x:Key="ProductDetailLabelStyle" TargetType="Label">
            <Setter Property="TextColor" Value="{DynamicResource RadSubtleColor}" />
            <Setter Property="VerticalTextAlignment" Value="Start" />
            <Setter Property="Margin" Value="0, 16" />
        </Style>
        <Style x:Key="ProductDetailValueLabelStyle" TargetType="Label">
            <Setter Property="TextColor" Value="{DynamicResource RadOnAppSurfaceColor}" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
            <Setter Property="HorizontalTextAlignment" Value="End" />
            <Setter Property="Margin" Value="0, 16" />
        </Style>
        <Style x:Key="ProductDetailSeparatorStyle" TargetType="telerik:RadBorder">
            <Setter Property="Grid.ColumnSpan" Value="2" />
            <Setter Property="HeightRequest" Value="1" />
            <Setter Property="Background" Value="{DynamicResource RadBaseSubtleColor}" />
            <Setter Property="VerticalOptions" Value="End" />
        </Style>
    </views:BasePage.Resources>

    <Grid RowDefinitions="Auto, *">
        <mobileViews:HeaderView />
        <HorizontalStackLayout HorizontalOptions="End"
                               VerticalOptions="Center"
                               Margin="0, 0, 16, 0">
            <telerik:RadTemplatedButton Command="{Binding ToolbarCommand}"
                                        CommandParameter="order"
                                        Content="&#xe833;"
                                        FontFamily="TelerikFontExamples"
                                        Style="{DynamicResource FlatButtonStyle}" />
            <telerik:RadTemplatedButton Command="{Binding ToolbarCommand}"
                                        CommandParameter="edit"
                                        Content="&#xe818;"
                                        FontFamily="TelerikFontExamples"
                                        Style="{DynamicResource FlatButtonStyle}" />
        </HorizontalStackLayout>
        <Grid Grid.Row="1"
              Padding="16"
              RowDefinitions="Auto, Auto, *"
              RowSpacing="16">
            <telerik:RadBorder BackgroundColor="{DynamicResource RadSurfaceColor}"
                               BorderColor="{DynamicResource RadBaseSubtleColor}"
                               BorderThickness="1"
                               CornerRadius="8">
                    <Grid HeightRequest="140">
                        <Image Source="{Binding SelectedProduct.PhotoImageSource, TargetNullValue='art_placeholder.png', FallbackValue='art_placeholder.png'}"
                               Aspect="AspectFill" />
                        <telerik:RadBorder IsVisible="{Binding SelectedProduct.IsDiscontinued}"
                                           Background="{DynamicResource RadErrorSubtleColor}"
                                           CornerRadius="18"
                                           HeightRequest="24"
                                           Padding="8, 0"
                                           Margin="0, 8, 8, 0"
                                           HorizontalOptions="End"
                                           VerticalOptions="Start">
                            <Label Text="Discontinued"
                                   TextColor="{DynamicResource RadErrorColor}"
                                   FontSize="10"
                                   VerticalTextAlignment="Center" />
                        </telerik:RadBorder>
                    </Grid>
            </telerik:RadBorder>
            <Label Grid.Row="1"
                   Text="{Binding SelectedProduct.Title}"
                   FontSize="16"
                   FontAttributes="Bold" />
            <Grid Grid.Row="2"
                  ColumnDefinitions="Auto, *"
                  ColumnSpacing="8"
                  RowDefinitions="Auto, Auto, Auto">
                <Label Text="Price"
                       Style="{StaticResource ProductDetailLabelStyle}" />
                <Label Grid.Column="1"
                       Text="{Binding SelectedProduct.Price, StringFormat='{0:C0}'}"
                       Style="{StaticResource ProductDetailValueLabelStyle}" />
                <telerik:RadBorder Style="{StaticResource ProductDetailSeparatorStyle}" />
                <Label Grid.Row="1"
                       Text="In Stock"
                       Style="{StaticResource ProductDetailLabelStyle}" />
                <Label Grid.Row="1"
                       Grid.Column="1"
                       Text="{Binding SelectedProduct.InventoryCount}"
                       Style="{StaticResource ProductDetailValueLabelStyle}" />
                <telerik:RadBorder Grid.Row="1"
                                   Style="{StaticResource ProductDetailSeparatorStyle}" />
                <Label Grid.Row="2"
                       Text="Description"
                       Style="{StaticResource ProductDetailLabelStyle}" />
                <Label Grid.Row="2"
                       Grid.Column="1"
                       Text="{Binding SelectedProduct.Description}"
                       Style="{StaticResource ProductDetailValueLabelStyle}"
                       LineBreakMode="WordWrap" />
            </Grid>
        </Grid>

        <telerik:RadBusyIndicator Grid.RowSpan="3"
                                  IsVisible="{Binding IsBusy}"
                                  IsBusy="{Binding IsBusy}"
                                  Style="{StaticResource OpaqueBusyIndicatorStyle}" />
    </Grid>
</views:BasePage>