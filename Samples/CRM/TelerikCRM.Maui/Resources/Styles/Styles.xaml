    <Style x:Key="NavigationViewItemBorderStyle" TargetType="telerik:RadBorder">
        <Setter Property="Background" Value="{DynamicResource RadAppSurfaceColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource RadBaseSubtleColor}" />
