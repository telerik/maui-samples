                        <VisualState.Setters>
                            <Setter Property="telerik:RadButton.Text" Value="{x:Static telerik:TelerikFont.IconCancel}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="telerik:RadButton.Text" Value="{x:Static telerik:TelerikFont.IconCancel}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="ModalDialogCloseButtonStyle_WinUI" TargetType="telerik:RadButton" BasedOn="{StaticResource ModalDialogCloseButtonBaseStyle}">
        <Setter Property="Text" Value="{x:Static telerik:TelerikFont.IconCancel}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="WidthRequest" Value="46" />
        <Setter Property="HeightRequest" Value="32" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup Name="CommonStates">
                    <VisualState Name="Normal" />
                    <VisualState Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="telerik:RadButton.TextColor" Value="#FFFFFF" />
                            <Setter Property="telerik:RadButton.BackgroundColor" Value="#C42B1C" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="telerik:RadButton.TextColor" Value="#FFFFFF" />
                            <Setter Property="telerik:RadButton.BackgroundColor" Value="#C42B1C" />
                            <Setter Property="telerik:RadButton.Opacity" Value="0.9" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="ActionButtonStyle" TargetType="telerik:RadTemplatedButton">
        <Setter Property="TextColor" Value="{DynamicResource RadOnPrimaryColor}" />
        <Setter Property="Background" Value="{DynamicResource RadPrimaryColor}" />
        <Setter Property="WidthRequest" Value="{OnPlatform Default=40, MacCatalyst=28}" />
        <Setter Property="HeightRequest" Value="{OnPlatform Default=40, MacCatalyst=28}" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Shadow" Value="{x:Null}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="MouseOver">
                        <VisualState.Setters>
                            <Setter Property="Background" Value="{DynamicResource RadPrimaryHoverColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Background" Value="{DynamicResource RadPrimaryActiveColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.6" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <telerik:DataFormGridLayout x:Key="DataFormGridLayout"
                                ColumnCount="{OnPlatform Default=1, MacCatalyst=2, WinUI=2}"
                                RowSpacing="{OnPlatform Default=16, MacCatalyst=8, WinUI=8}"
                                ColumnSpacing="{OnPlatform Default=0, MacCatalyst=16, WinUI=16}" />

    <Style x:Key="DataFormHeaderLabelStyle" TargetType="Label">
        <Setter Property="MinimumWidthRequest" Value="100" />
        <Setter Property="TextColor" Value="{OnPlatform Default={DynamicResource RadSubtleColor}, MacCatalyst={DynamicResource RadOnAppSurfaceColor}, WinUI={DynamicResource RadOnAppSurfaceColor}}" />
        <Setter Property="Margin" Value="{OnPlatform Default='0, 0, 0, 4', MacCatalyst=0, WinUI=0}" />
    </Style>

    <Style x:Key="DataFormEditorStyle" TargetType="telerik:DataFormEditor">
        <Setter Property="HeaderPosition" Value="{OnPlatform Default=Above, MacCatalyst=Beside, WinUI=Beside}" />
        <Setter Property="HeaderLabelStyle" Value="{StaticResource DataFormHeaderLabelStyle}" />
        <!-- TODO: Temp - verify with designers what is the desired validation behavior -->
        <Setter Property="ErrorDisplayOptions" Value="None" />
        <Setter Property="RowSpacing" Value="0" />
        <Setter Property="ColumnSpacing" Value="0" />
    </Style>

    <Style x:Key="DataFormCustomMultilineEditorHeaderLabelStyle" TargetType="Label" BasedOn="{StaticResource DataFormHeaderLabelStyle}">
        <Setter Property="VerticalOptions" Value="Start" />
        <Setter Property="Margin" Value="{OnPlatform Default='0, 0, 0, 4', MacCatalyst='0, 8, 0, 0'}" />
    </Style>

    <Style x:Key="DataFormCustomMultilineEditorStyle" TargetType="telerik:DataFormEditor" BasedOn="{StaticResource DataFormEditorStyle}">
        <Setter Property="HeaderLabelStyle" Value="{StaticResource DataFormCustomMultilineEditorHeaderLabelStyle}" />
    </Style>

    <ControlTemplate x:Key="DataFormCustomMultilineEditorTemplate">
        <telerik:RadBorder BackgroundColor="{OnPlatform MacCatalyst={DynamicResource RadAppSurfaceColor}}"
                           BorderColor="{DynamicResource RadBorderColor}"
                           BorderThickness="{OnPlatform Default=0, iOS=1, MacCatalyst=1}"
                           Padding="{OnPlatform iOS='3, 0', MacCatalyst='1, 0'}"
                           CornerRadius="{OnPlatform iOS=10, MacCatalyst=6}">
            <Editor BackgroundColor="{OnPlatform MacCatalyst=Transparent}"
                    Text="{Binding Value, Mode=TwoWay, Source={RelativeSource Mode=TemplatedParent}}"
                    VerticalTextAlignment="{OnPlatform Android=Start, iOS=Start}" />
        </telerik:RadBorder>
    </ControlTemplate>

    <ControlTemplate x:Key="DataFormCustomBooleanEditorTemplate">
        <Switch BackgroundColor="{OnPlatform MacCatalyst=Transparent}"
                IsToggled="{Binding Value, Mode=TwoWay, Source={RelativeSource Mode=TemplatedParent}}"
                HorizontalOptions="Start" />
    </ControlTemplate>
</ResourceDictionary>
