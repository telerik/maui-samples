    <Style x:Key="ModalDialogHeaderStyle" TargetType="Label">
        <Setter Property="FontAttributes" Value="{OnPlatform Default=None, MacCatalyst=Bold}" />
        <Setter Property="HorizontalTextAlignment" Value="{OnPlatform Default=Start, MacCatalyst=Center}" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="Margin" Value="{OnPlatform Default='16, 0, 0, 0', WinUI='0, 0, 12, 0'}" />
    </Style>

    <Style x:Key="ModalDialogCloseButtonBaseStyle" TargetType="telerik:RadButton">
        <Setter Property="FontFamily" Value="{x:Static telerik:TelerikFont.Name}" />
        <Setter Property="TextColor" Value="Black" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="ModalDialogCloseButtonStyle_MacCatalyst" TargetType="telerik:RadButton" BasedOn="{StaticResource ModalDialogCloseButtonBaseStyle}">
        <Setter Property="FontSize" Value="6" />
        <Setter Property="BackgroundColor" Value="#FF5F57" />
        <Setter Property="BorderColor" Value="#1F000000" />
        <Setter Property="BorderWidth" Value="0.5" />
        <Setter Property="WidthRequest" Value="12" />
        <Setter Property="HeightRequest" Value="12" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup Name="CommonStates">
                    <VisualState Name="Normal" />
