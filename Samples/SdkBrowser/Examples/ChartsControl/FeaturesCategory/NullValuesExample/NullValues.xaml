<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:charts="clr-namespace:Telerik.Maui.Controls.Charts;assembly=Telerik.Maui.Controls"
             xmlns:models="clr-namespace:SDKBrowserMaui.Examples.ChartsControl.FeaturesCategory.NullValuesExample"
             x:Class="SDKBrowserMaui.Examples.ChartsControl.FeaturesCategory.NullValuesExample.NullValues">
    <!-- >> chart-cartesian-null-values-xaml -->
    <charts:RadCartesianChart>
        <charts:RadCartesianChart.BindingContext>
            <models:ViewModel />
        </charts:RadCartesianChart.BindingContext>
        <charts:RadCartesianChart.Axes>
            <charts:CategoricalAxis />
            <charts:NumericalAxis />
        </charts:RadCartesianChart.Axes>
        <charts:RadCartesianChart.Series>
            <charts:SplineAreaSeries HorizontalBinding="Category"
                                     VerticalBinding="Value"
                                     ItemsSource="{Binding Data}" />
        </charts:RadCartesianChart.Series>
    </charts:RadCartesianChart>
    <!-- << chart-cartesian-null-values-xaml -->
</ContentView>
