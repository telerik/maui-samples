<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:charts="clr-namespace:Telerik.Maui.Controls.Charts;assembly=Telerik.Maui.Controls"
             xmlns:models="clr-namespace:SDKBrowserMaui.Examples.ChartsControl"
             x:Class="SDKBrowserMaui.Examples.ChartsControl.SeriesCategory.PieSeriesExample.PieChartPieSeries">
    <!-- >> chart-pie-series-xaml -->
    <charts:RadPieChart>
        <charts:RadPieChart.BindingContext>
            <models:PieViewModel />
        </charts:RadPieChart.BindingContext>
        <charts:RadPieChart.Series>
            <charts:PieSeries ValueBinding="Value"
                              LabelBinding="Label"
                              LabelOffsetFraction="0.85"
                              ItemsSource="{Binding Data}" />
        </charts:RadPieChart.Series>
    </charts:RadPieChart>
    <!-- << chart-pie-series-xaml -->
</ContentView>
