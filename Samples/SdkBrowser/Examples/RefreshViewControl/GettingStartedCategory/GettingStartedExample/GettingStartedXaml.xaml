<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:telerik="http://schemas.telerik.com/2022/xaml/maui"
             x:Class="SDKBrowserMaui.Examples.RefreshViewControl.GettingStartedCategory.GettingStartedExample.GettingStartedXaml">
    <!-- >> refreshview-getting-started-xaml -->
    <telerik:RadRefreshView x:Name="refreshView"
                            Refreshing="OnRefreshing">
        <VerticalStackLayout Padding="20"
                             Spacing="12"
                             BackgroundColor="#EEEEEE">
            <Label Text="Weather Summary"
                   FontSize="20"
                   FontAttributes="Bold" />
            <HorizontalStackLayout Spacing="8">
                <Label Text="Temperature:" FontAttributes="Bold" />
                <Label x:Name="temperatureLabel" Text="21 °C" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="8">
                <Label Text="Humidity:" FontAttributes="Bold" />
                <Label x:Name="humidityLabel" Text="45 %" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="8">
                <Label Text="Wind:" FontAttributes="Bold" />
                <Label x:Name="windLabel" Text="12 km/h" />
            </HorizontalStackLayout>
            <Label x:Name="refreshCountLabel"
                   Text="Not refreshed yet" />
        </VerticalStackLayout>
    </telerik:RadRefreshView>
    <!-- << refreshview-getting-started-xaml -->
</ContentView>
