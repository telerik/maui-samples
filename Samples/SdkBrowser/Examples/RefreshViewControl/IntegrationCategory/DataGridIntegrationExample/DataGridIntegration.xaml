<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:telerik="http://schemas.telerik.com/2022/xaml/maui"
             xmlns:local="clr-namespace:SDKBrowserMaui.Examples.RefreshViewControl.IntegrationCategory"
             x:Class="SDKBrowserMaui.Examples.RefreshViewControl.IntegrationCategory.DataGridIntegrationExample.DataGridIntegration">
    <ContentView.BindingContext>
        <local:ViewModel />
    </ContentView.BindingContext>
    <!-- >> refreshview-integration-datagrid -->
    <telerik:RadRefreshView IsRefreshing="{Binding IsRefreshing}"
                            Command="{Binding RefreshCommand}">
        <telerik:RadDataGrid ItemsSource="{Binding Items}"
                             AutoGenerateColumns="False">
            <telerik:RadDataGrid.Columns>
                <telerik:DataGridNumericalColumn PropertyName="Id" />
                <telerik:DataGridTextColumn PropertyName="Name" />
                <telerik:DataGridTextColumn PropertyName="City" />
                <telerik:DataGridNumericalColumn PropertyName="Orders" />
            </telerik:RadDataGrid.Columns>
        </telerik:RadDataGrid>
    </telerik:RadRefreshView>
    <!-- << refreshview-integration-datagrid -->
</ContentView>
