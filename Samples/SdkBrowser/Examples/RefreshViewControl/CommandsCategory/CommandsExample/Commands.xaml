<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:telerik="http://schemas.telerik.com/2022/xaml/maui"
             xmlns:local="clr-namespace:SDKBrowserMaui.Examples.RefreshViewControl.CommandsCategory.CommandsExample"
             x:Class="SDKBrowserMaui.Examples.RefreshViewControl.CommandsCategory.CommandsExample.Commands">
    <ContentView.BindingContext>
        <local:ViewModel />
    </ContentView.BindingContext>
    <Grid RowDefinitions="Auto, *"
          RowSpacing="10">
        <HorizontalStackLayout Spacing="10">
            <telerik:RadCheckBox IsChecked="{Binding CanRefresh}" />
            <Label Text="Command CanExecute"
                   VerticalOptions="Center" />
        </HorizontalStackLayout>
        <!-- >> refreshview-commands -->
        <telerik:RadRefreshView Grid.Row="1"
                                IsRefreshing="{Binding IsRefreshing}"
                                Command="{Binding RefreshCommand}"
                                CommandParameter="News">
            <VerticalStackLayout Padding="20"
                                 Spacing="10"
                                 BackgroundColor="#EEEEEE">
                <Label Text="Pull down to execute the RefreshCommand." />
                <Label Text="{Binding Headline}"
                       FontAttributes="Bold" />
                <Label Text="{Binding Status}"
                       TextColor="Gray" />
            </VerticalStackLayout>
        </telerik:RadRefreshView>
        <!-- << refreshview-commands -->
    </Grid>
</ContentView>
