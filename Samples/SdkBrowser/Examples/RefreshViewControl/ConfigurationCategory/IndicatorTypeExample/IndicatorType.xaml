<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:telerik="http://schemas.telerik.com/2022/xaml/maui"
             x:Class="SDKBrowserMaui.Examples.RefreshViewControl.ConfigurationCategory.IndicatorTypeExample.IndicatorType">
    <!-- >> refreshview-indicator-type -->
    <telerik:RadRefreshView x:Name="refreshView"
                            IndicatorType="Circular"
                            Refreshing="OnRefreshing">
        <VerticalStackLayout Padding="20"
                             Spacing="10"
                             BackgroundColor="#EEEEEE">
            <Label Text="IndicatorType:"
                   VerticalOptions="Center" />
            <telerik:RadComboBox x:Name="indicatorTypeComboBox"
                                 HorizontalOptions="Start"
                                 WidthRequest="160" />
            <Label Text="Pull down to see the selected indicator." />
            <Label x:Name="statusLabel"
                   Text="Not refreshed yet" />
        </VerticalStackLayout>
    </telerik:RadRefreshView>
    <!-- << refreshview-indicator-type -->
</ContentView>
