<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:telerik="http://schemas.telerik.com/2022/xaml/maui"
             x:Class="SDKBrowserMaui.Examples.RefreshViewControl.ConfigurationCategory.PullDirectionExample.PullDirection">
    <!-- >> refreshview-pull-direction -->
    <telerik:RadRefreshView x:Name="refreshView"
                            PullDirection="BottomToTop"
                            Refreshing="OnRefreshing">
        <VerticalStackLayout Padding="20"
                             Spacing="10"
                             BackgroundColor="#EEEEEE">
            <Label Text="PullDirection:"
                   VerticalOptions="Center" />
            <telerik:RadComboBox x:Name="pullDirectionComboBox"
                                 HorizontalOptions="Start"
                                 WidthRequest="200" />
            <Label x:Name="hintLabel"
                   Text="Pull in the selected direction to refresh." />
            <Label x:Name="statusLabel"
                   Text="Not refreshed yet" />
        </VerticalStackLayout>
    </telerik:RadRefreshView>
    <!-- << refreshview-pull-direction -->
</ContentView>
