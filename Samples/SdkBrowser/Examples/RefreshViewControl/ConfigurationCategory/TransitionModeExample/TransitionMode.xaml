<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:telerik="http://schemas.telerik.com/2022/xaml/maui"
             x:Class="SDKBrowserMaui.Examples.RefreshViewControl.ConfigurationCategory.TransitionModeExample.TransitionMode">
    <!-- >> refreshview-transition-mode -->
    <telerik:RadRefreshView x:Name="refreshView"
                            TransitionMode="Push"
                            Refreshing="OnRefreshing">
        <VerticalStackLayout Padding="20"
                             Spacing="10"
                             BackgroundColor="#EEEEEE">
            <Label Text="TransitionMode:"
                   VerticalOptions="Center" />
            <telerik:RadComboBox x:Name="transitionModeComboBox"
                                 HorizontalOptions="Start"
                                 WidthRequest="160" />
            <Label Text="Pull down to see how the indicator and the content move." />
            <Label x:Name="statusLabel"
                   Text="Not refreshed yet" />
        </VerticalStackLayout>
    </telerik:RadRefreshView>
    <!-- << refreshview-transition-mode -->
</ContentView>
