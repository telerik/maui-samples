<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:telerik="http://schemas.telerik.com/2022/xaml/maui"
             x:Class="SDKBrowserMaui.Examples.RefreshViewControl.ConfigurationCategory.RefreshStateExample.RefreshState">
    <!-- >> refreshview-refresh-state -->
    <telerik:RadRefreshView x:Name="refreshView"
                            IsRefreshEnabled="True"
                            Refreshed="OnRefreshed">
        <VerticalStackLayout Padding="20"
                             Spacing="10"
                             BackgroundColor="#EEEEEE">
            <HorizontalStackLayout Spacing="10">
                <telerik:RadCheckBox IsChecked="{Binding Source={x:Reference refreshView}, Path=IsRefreshEnabled}" />
                <Label Text="IsRefreshEnabled"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="10">
                <telerik:RadTemplatedButton Content="Start Refresh"
                                            Background="LightGray"
                                            Clicked="OnStartRefreshClicked" />
                <telerik:RadTemplatedButton Content="Stop Refresh"
                                            Background="LightGray"
                                            Clicked="OnStopRefreshClicked" />
            </HorizontalStackLayout>
            <Label Text="{Binding Source={x:Reference refreshView}, Path=IsRefreshing, StringFormat='IsRefreshing: {0}'}" />
            <Label Text="Pull down or use the buttons to toggle IsRefreshing. Uncheck IsRefreshEnabled to disable the pull gesture." />
            <Label x:Name="statusLabel"
                   Text="Not refreshed yet" />
        </VerticalStackLayout>
    </telerik:RadRefreshView>
    <!-- << refreshview-refresh-state -->
</ContentView>
