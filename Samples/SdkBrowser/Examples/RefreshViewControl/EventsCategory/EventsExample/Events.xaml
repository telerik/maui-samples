<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:telerik="http://schemas.telerik.com/2022/xaml/maui"
             x:Class="SDKBrowserMaui.Examples.RefreshViewControl.EventsCategory.EventsExample.Events">
    <Grid RowDefinitions="Auto, *, Auto, 150"
          RowSpacing="10">
        <HorizontalStackLayout Spacing="10">
            <telerik:RadCheckBox x:Name="cancelCheckBox" />
            <Label Text="Cancel the pull when Progress exceeds 50%"
                   VerticalOptions="Center" />
        </HorizontalStackLayout>
        <!-- >> refreshview-events -->
        <telerik:RadRefreshView x:Name="refreshView"
                                Grid.Row="1"
                                Pulling="OnPulling"
                                Refreshing="OnRefreshing"
                                Refreshed="OnRefreshed">
            <VerticalStackLayout Padding="20"
                                 Spacing="10"
                                 BackgroundColor="#EEEEEE">
                <Label Text="Pull down to raise the Pulling, Refreshing and Refreshed events." />
                <Label x:Name="progressLabel"
                       Text="Progress: 0 %" />
            </VerticalStackLayout>
        </telerik:RadRefreshView>
        <!-- << refreshview-events -->
        <Label Grid.Row="2"
               Text="Events log:"
               FontAttributes="Bold" />
        <ScrollView Grid.Row="3">
            <Label x:Name="logLabel" />
        </ScrollView>
    </Grid>
</ContentView>
