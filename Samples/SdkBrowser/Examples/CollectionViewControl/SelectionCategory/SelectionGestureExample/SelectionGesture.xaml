<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:telerik="http://schemas.telerik.com/2022/xaml/maui"
             xmlns:local="clr-namespace:SDKBrowserMaui.Examples.CollectionViewControl.SelectionCategory"
             x:Class="SDKBrowserMaui.Examples.CollectionViewControl.SelectionCategory.SelectionGestureExample.SelectionGesture">
    <Grid RowDefinitions="Auto, *">
        <HorizontalStackLayout Spacing="10">
            <Label Text="Selection Gesture: "
                   VerticalTextAlignment="Center" />
            <telerik:RadComboBox SelectedItem="{Binding Source={x:Reference collectionView}, Path=SelectionGesture}">
                <telerik:RadComboBox.ItemsSource>
                    <x:Array Type="{x:Type telerik:CollectionViewSelectionGesture}">
                        <telerik:CollectionViewSelectionGesture>Hold</telerik:CollectionViewSelectionGesture>
                        <telerik:CollectionViewSelectionGesture>Tap</telerik:CollectionViewSelectionGesture>
                    </x:Array>
                </telerik:RadComboBox.ItemsSource>
            </telerik:RadComboBox>
        </HorizontalStackLayout>
        <!-- >> collectionview-selectiongesture-->
        <telerik:RadCollectionView ItemsSource="{Binding Items}"
                                   SelectionGesture="Hold"
                                   DisplayMemberPath="Name"
                                   SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                   x:Name="collectionView"
                                   Grid.Row="1">
            <telerik:RadCollectionView.BindingContext>
                <local:ViewModel />
            </telerik:RadCollectionView.BindingContext>
        </telerik:RadCollectionView>
        <!-- << collectionview-selectiongesture -->
    </Grid>
</ContentView>
