<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:telerik="http://schemas.telerik.com/2022/xaml/maui"
             xmlns:local="clr-namespace:SDKBrowserMaui.Examples.DropDownButtonControl.FeaturesCategory.CommandExample"
             x:Class="SDKBrowserMaui.Examples.DropDownButtonControl.FeaturesCategory.CommandExample.Command">
    <VerticalStackLayout HorizontalOptions="{OnIdiom Default=Fill, Desktop=Start}"
                         VerticalOptions="Start"
                         WidthRequest="{OnPlatform WinUI=320, MacCatalyst=320}">
        <!-- >> dropdownbutton-command-xaml -->
        <telerik:RadDropDownButton Content="{Binding ButtonText}"
                                   Command="{Binding ToggleCommand}">
            <telerik:RadDropDownButton.DropDownContent>
                <Label Text="{Binding StatusText}"
                       Padding="8" />
            </telerik:RadDropDownButton.DropDownContent>
        </telerik:RadDropDownButton>
        <!-- << dropdownbutton-command-xaml -->
        <VerticalStackLayout.BindingContext>
            <local:ViewModel />
        </VerticalStackLayout.BindingContext>
    </VerticalStackLayout>
</ContentView>
