<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:telerik="http://schemas.telerik.com/2022/xaml/maui"
             x:Class="SDKBrowserMaui.Examples.DropDownButtonControl.FeaturesCategory.DropDownConfigurationExample.DropDownConfiguration">
    <ContentView.Resources>
        <Style TargetType="Label" x:Key="LabelStyle">
            <Setter Property="HorizontalOptions" Value="Start" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="Margin" Value="0, 20, 0, 8" />
        </Style>
    </ContentView.Resources>
    <ScrollView>
        <VerticalStackLayout WidthRequest="{OnPlatform MacCatalyst=300, WinUI=300}"
                             VerticalOptions="Start"
                             HorizontalOptions="{OnIdiom Default=Fill, Desktop=Start}">
            <Label Text="DropDownWidth='240', DropDownHeight='120':" Style="{StaticResource LabelStyle}" />
            <!-- >> dropdownbutton-dropdownconfiguration-size -->
            <telerik:RadDropDownButton Content="Fixed size"
                                       DropDownWidth="240"
                                       DropDownHeight="120">
                <telerik:RadDropDownButton.DropDownContent>
                    <Label Text="Drop-down with explicit Width and Height." />
                </telerik:RadDropDownButton.DropDownContent>
            </telerik:RadDropDownButton>
            <!-- << dropdownbutton-dropdownconfiguration-size -->

            <Label Text="DropDownContentPadding='16':" Style="{StaticResource LabelStyle}" />
            <!-- >> dropdownbutton-dropdownconfiguration-contentpadding -->
            <telerik:RadDropDownButton Content="Content padding"
                                       DropDownContentPadding="16">
                <telerik:RadDropDownButton.DropDownContent>
                    <Label Text="Extra padding around the drop-down content." />
                </telerik:RadDropDownButton.DropDownContent>
            </telerik:RadDropDownButton>
            <!-- << dropdownbutton-dropdownconfiguration-contentpadding -->

            <Label Text="DropDownVerticalOffset='16', DropDownHorizontalOffset='16':" Style="{StaticResource LabelStyle}" />
            <!-- >> dropdownbutton-dropdownconfiguration-offsets -->
            <telerik:RadDropDownButton Content="Offsets"
                                       DropDownVerticalOffset="16"
                                       DropDownHorizontalOffset="16">
                <telerik:RadDropDownButton.DropDownContent>
                    <Label Text="Positioned with additional vertical and horizontal offsets." />
                </telerik:RadDropDownButton.DropDownContent>
            </telerik:RadDropDownButton>
            <!-- << dropdownbutton-dropdownconfiguration-offsets -->
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
