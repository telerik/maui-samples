<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:telerik="http://schemas.telerik.com/2022/xaml/maui"
             xmlns:local="clr-namespace:SDKBrowserMaui.Examples.CarouselControl"
             x:Class="SDKBrowserMaui.Examples.CarouselControl.ConfigurationCategory.ItemEffectsExample.ItemEffects">
    <ContentView.BindingContext>
        <local:CarouselViewModel />
    </ContentView.BindingContext>
    <Grid RowDefinitions="Auto, *" RowSpacing="12" Padding="12">
        <HorizontalStackLayout Spacing="8">
            <telerik:RadCheckBox x:Name="effectsCheckBox" IsChecked="{Binding AreItemEffectsEnabled, Source={x:Reference carousel}}" VerticalOptions="Center" />
            <Label Text="Are Item Effects Enabled" VerticalOptions="Center" />
        </HorizontalStackLayout>
        <!-- >> carousel-item-effects -->
        <telerik:RadCarousel Grid.Row="1"
                             PeekAreaRatio="0.4"
                             MaximumHeightRequest="{OnPlatform Android=450, iOS=450}"
                             VerticalOptions="{OnPlatform Android=Start, iOS=Start}"
                             ItemsSource="{Binding Items}"
                             x:Name="carousel">
            <telerik:RadCarousel.ItemEffectSettings>
                <telerik:CarouselItemEffectSettings>
                    <telerik:CarouselItemEffectSettings.Highlighted>
                        <telerik:CarouselItemEffect Scale="1" Opacity="1" />
                    </telerik:CarouselItemEffectSettings.Highlighted>
                    <telerik:CarouselItemEffectSettings.Previous>
                        <telerik:CarouselItemEffect Scale="0.85" Opacity="0.7" />
                    </telerik:CarouselItemEffectSettings.Previous>
                    <telerik:CarouselItemEffectSettings.Next>
                        <telerik:CarouselItemEffect Scale="0.85" Opacity="0.7" />
                    </telerik:CarouselItemEffectSettings.Next>
                    <telerik:CarouselItemEffectSettings.Normal>
                        <telerik:CarouselItemEffect Scale="0.6" Opacity="0.3" />
                    </telerik:CarouselItemEffectSettings.Normal>
                </telerik:CarouselItemEffectSettings>
            </telerik:RadCarousel.ItemEffectSettings>
            <telerik:RadCarousel.ItemTemplate>
                <DataTemplate x:DataType="local:CarouselItem">
                    <Image Source="{Binding Image}" Aspect="AspectFill" />
                </DataTemplate>
            </telerik:RadCarousel.ItemTemplate>
        </telerik:RadCarousel>
        <!-- << carousel-item-effects -->
    </Grid>
</ContentView>
