<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:telerik="http://schemas.telerik.com/2022/xaml/maui"
             x:Class="SDKBrowserMaui.Examples.CircularSliderControl.TicksCategory.TickTemplateExample.TickTemplate">
    <ContentView.Resources>
        <!-- >> circularslider-ticks-ticktemplate-datatemplate -->
        <DataTemplate x:Key="CustomTickTemplate">
            <Rectangle WidthRequest="4"
                       HeightRequest="10"
                       BackgroundColor="#7C59B6" />
        </DataTemplate>
        <!-- << circularslider-ticks-ticktemplate-datatemplate -->
    </ContentView.Resources>
    <Grid>
        <!-- >> circularslider-ticks-ticktemplate-xaml -->
        <telerik:RadCircularSlider Minimum="0"
                                   Maximum="100"
                                   Value="35"
                                   TicksPlacement="Start"
                                   TickStep="20"
                                   TickTemplate="{StaticResource CustomTickTemplate}"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Start"
                                   MinimumHeightRequest="300" />
        <!-- << circularslider-ticks-ticktemplate-xaml -->
    </Grid>
</ContentView>
