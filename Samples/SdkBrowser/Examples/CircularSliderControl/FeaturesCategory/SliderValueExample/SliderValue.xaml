<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:telerik="http://schemas.telerik.com/2022/xaml/maui"
             x:Class="SDKBrowserMaui.Examples.CircularSliderControl.FeaturesCategory.SliderValueExample.SliderValue">
        <Grid RowDefinitions="Auto, Auto"
                    RowSpacing="10">
        <!-- >> circularslider-value-xaml -->
        <telerik:RadCircularSlider Grid.Row="0"
                                   Minimum="0"
                                   Maximum="100"
                                   Value="{Binding MyValue, Mode=TwoWay}"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Start"
                                   MinimumHeightRequest="300" />
        <!-- << circularslider-value-xaml -->
            <HorizontalStackLayout Grid.Row="1"
                               Spacing="5"
                               HorizontalOptions="Center">
            <Label Text="Current Value: " />
            <Label Text="{Binding MyValue, StringFormat='{0:N2}'}" />
        </HorizontalStackLayout>
    </Grid>
</ContentView>
