<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:telerik="http://schemas.telerik.com/2022/xaml/maui"
             x:Class="SDKBrowserMaui.Examples.CircularSliderControl.FeaturesCategory.DragModeExample.DragMode">
    <ContentView.Resources>
        <Style TargetType="telerik:RadCircularSlider">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Value" Value="35" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="HorizontalTextAlignment" Value="Center" />
        </Style>
    </ContentView.Resources>
    <Grid RowDefinitions="Auto, Auto, Auto"
          RowSpacing="10">
        <Grid Grid.Row="0"
              RowDefinitions="Auto, Auto">
            <Label Grid.Row="0"
                   Text="Only thumb:" />
            <!-- >> circularslider-drag-thumb-xaml -->
            <telerik:RadCircularSlider Grid.Row="1"
                                       DragMode="Thumb"
                                       HorizontalOptions="Fill"
                                       VerticalOptions="Start"
                                       MinimumHeightRequest="{OnPlatform iOS=230}" />
            <!-- << circularslider-drag-thumb-xaml -->
        </Grid>
        <Grid Grid.Row="1"
              RowDefinitions="Auto, Auto">
            <Label Grid.Row="0"
                   Text="Free:" />
            <!-- >> circularslider-drag-free-xaml -->
            <telerik:RadCircularSlider Grid.Row="1"
                                       DragMode="Free"
                                       HorizontalOptions="Fill"
                                       VerticalOptions="Start"
                                       MinimumHeightRequest="{OnPlatform iOS=230}" />
            <!-- << circularslider-drag-free-xaml -->
        </Grid>
        <Grid Grid.Row="2"
              RowDefinitions="Auto, Auto">
            <Label Grid.Row="0"
                   Text="Disabled:" />
            <!-- >> circularslider-drag-disabled-xaml -->
            <telerik:RadCircularSlider Grid.Row="1"
                                       DragMode="Disabled"
                                       HorizontalOptions="Fill"
                                       VerticalOptions="Start"
                                       MinimumHeightRequest="{OnPlatform iOS=230}" />
            <!-- << circularslider-drag-disabled-xaml -->
        </Grid>
    </Grid>
</ContentView>
