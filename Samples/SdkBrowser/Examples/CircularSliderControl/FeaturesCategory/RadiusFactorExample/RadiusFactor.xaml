<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:telerik="http://schemas.telerik.com/2022/xaml/maui"
             x:Class="SDKBrowserMaui.Examples.CircularSliderControl.FeaturesCategory.RadiusFactorExample.RadiusFactor">
    <Grid RowDefinitions="Auto, Auto, Auto"
          RowSpacing="10">
        <!-- >> circularslider-radius-factor -->
        <telerik:RadCircularSlider Grid.Row="0"
                                   x:Name="circularSlider"
                                   Minimum="0"
                                   Maximum="100"
                                   Value="35"
                                   RadiusFactor="0.6"
                                   HeightRequest="300"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Start"
                                   MinimumHeightRequest="{OnPlatform iOS=300}" />
        <!-- << circularslider-radius-factor -->
        <Label Grid.Row="1"
               HorizontalOptions="Center"
               Text="{Binding Source={x:Reference circularSlider}, Path=RadiusFactor, StringFormat='Radius factor: {0:F2}'}" />
        <telerik:RadSlider Grid.Row="2"
                           Minimum="0.3"
                           Maximum="1"
                           Value="{Binding Source={x:Reference circularSlider}, Path=RadiusFactor, Mode=TwoWay}"
                           HorizontalOptions="Center"
                           WidthRequest="300" />
    </Grid>
</ContentView>
