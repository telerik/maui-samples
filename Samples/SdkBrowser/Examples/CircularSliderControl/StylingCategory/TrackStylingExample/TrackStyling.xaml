<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:telerik="http://schemas.telerik.com/2022/xaml/maui"
             x:Class="SDKBrowserMaui.Examples.CircularSliderControl.StylingCategory.TrackStylingExample.TrackStyling">
    <Grid>
        <!-- >> circularslider-track-style-xaml -->
        <telerik:RadCircularSlider Minimum="0"
                                   Maximum="100"
                                   Value="35"
                                   BackTrackColor="#80CBC4"
                                   BackTrackThickness="10"
                                   RangeTrackFill="#009688"
                                   ThumbFill="#00695C"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Start"
                                   MinimumHeightRequest="300" />
        <!-- << circularslider-track-style-xaml -->
    </Grid>
</ContentView>
