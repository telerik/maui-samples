<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:telerik="http://schemas.telerik.com/2022/xaml/maui"
             x:Class="SDKBrowserMaui.Examples.PromptInputControl.FeaturesCategory.ButtonsVisibilityExample.ButtonsVisibility">
    <ContentView.Resources>
        <ResourceDictionary>
            <Style TargetType="HorizontalStackLayout">
                <Setter Property="Spacing" Value="5" />
                <Setter Property="HorizontalOptions" Value="Start" />
            </Style>
            <Style TargetType="VerticalStackLayout">
                <Setter Property="Spacing" Value="10" />
                <Setter Property="HorizontalOptions" Value="Start" />
            </Style>
            <Style TargetType="telerik:RadCheckBox">
                <Setter Property="IsThreeState" Value="False" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>
            <Style TargetType="Label">
                <Setter Property="VerticalTextAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>
    <VerticalStackLayout>
        <HorizontalStackLayout>
            <telerik:RadCheckBox x:Name="checkBoxIsMoreButtonVisible"
                                 IsChecked="{Binding IsMoreButtonVisible, Source={x:Reference promptInput}}" />
            <Label Text="IsMoreButtonVisible" 
                   telerik:RadCheckBox.ToggleOnTap="{x:Reference checkBoxIsMoreButtonVisible}" />
        </HorizontalStackLayout>
        <HorizontalStackLayout>
            <telerik:RadCheckBox x:Name="checkBoxIsSpeechToTextButtonVisible"
                                 IsChecked="{Binding IsSpeechToTextButtonVisible, Source={x:Reference promptInput}}" />
            <Label Text="IsSpeechToTextButtonVisible" 
                   telerik:RadCheckBox.ToggleOnTap="{x:Reference checkBoxIsSpeechToTextButtonVisible}" />
        </HorizontalStackLayout>
        <!-- >> promptinput-buttons-visibility -->
        <telerik:RadPromptInput x:Name="promptInput"
                                IsMoreButtonVisible="False"
                                IsSpeechToTextButtonVisible="True" />
        <!-- << promptinput-buttons-visibility -->
    </VerticalStackLayout>
</ContentView>
