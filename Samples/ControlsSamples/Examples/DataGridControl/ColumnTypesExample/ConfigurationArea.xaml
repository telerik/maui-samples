<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:telerik="http://schemas.telerik.com/2022/xaml/maui"
             xmlns:styles="clr-namespace:QSF.Styles"
             x:Class="QSF.Examples.DataGridControl.ColumnTypesExample.ConfigurationArea">
    <ContentView.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <styles:ConfigurationViewResources />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentView.Resources>

    <VerticalStackLayout Style="{StaticResource RootAtSeparateAreaStyle}">
        <HorizontalStackLayout telerik:RadCheckBox.ToggleOnTap="{Reference CheckBoxShowColumnHeaders}"
                               Style="{StaticResource CheckBoxGroupStyle}">
            <telerik:RadCheckBox x:Name="CheckBoxShowColumnHeaders"
                                 IsChecked="{Binding ShowColumnHeaders}"
                                 AutomationId="showColumnHeadersCheckBox" />
            <Label Text="Are Column Headers Visible"
                   Style="{StaticResource HorizontalGroupLabelAtEndStyle}" />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentView>
