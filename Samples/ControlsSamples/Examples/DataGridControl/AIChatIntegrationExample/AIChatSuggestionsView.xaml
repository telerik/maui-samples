<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:telerik="http://schemas.telerik.com/2022/xaml/maui"
             xmlns:example="clr-namespace:QSF.Examples.DataGridControl.AIChatIntegrationExample"
             x:Class="QSF.Examples.DataGridControl.AIChatIntegrationExample.AIChatSuggestionsView">
    <ContentView.Resources>
        <Style x:Key="AIChatNavigationButtonStyleBase" TargetType="telerik:RadTemplatedButton">
            <Setter Property="WidthRequest" Value="{OnPlatform Default=32, MacCatalyst=20}" />
            <Setter Property="HeightRequest" Value="{OnPlatform Default=32, MacCatalyst=20}" />
            <Setter Property="FontFamily" Value="{x:Static telerik:TelerikFont.Name}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
            <Setter Property="Shadow" Value="{x:Null}" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <Setter.Value>
                    <VisualStateGroupList>
                        <VisualStateGroup Name="CommonStates">
                            <VisualState Name="Normal" />
                            <VisualState Name="PointerOver" />
                            <VisualState Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="TextColor" Value="{DynamicResource RadOnAppSurfaceColorAlpha50}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="Opacity" Value="0.6" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AIChatPreviousNavigationButtonStyle" TargetType="telerik:RadTemplatedButton" BasedOn="{StaticResource AIChatNavigationButtonStyleBase}">
            <Setter Property="Content" Value="{x:Static telerik:TelerikFont.IconGoToPreviousPage}" />
        </Style>
        <Style x:Key="AIChatNextNavigationButtonStyle" TargetType="telerik:RadTemplatedButton" BasedOn="{StaticResource AIChatNavigationButtonStyleBase}">
            <Setter Property="Content" Value="{x:Static telerik:TelerikFont.IconGoToNextPage}" />
        </Style>
        <DataTemplate x:Key="AIChatSuggestionItemTemplate">
            <telerik:RadBorder CornerRadius="{OnPlatform Default='2', MacCatalyst='4'}"
                               BackgroundColor="{DynamicResource RadPrimaryColor}"
                               BindingContext="{Binding}">
                <Label Padding="{OnPlatform Default='10, 8', MacCatalyst='10, 1'}"
                       Text="{Binding}"
                       FontSize="14"
                       TextColor="{DynamicResource RadOnPrimaryColor}" />
                <telerik:RadBorder.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type Grid}}, Path=BindingContext.ItemTapCommand}"
                                          CommandParameter="{Binding}" />
                </telerik:RadBorder.GestureRecognizers>
            </telerik:RadBorder>
        </DataTemplate>
    </ContentView.Resources>
    <ContentView.ControlTemplate>
        <ControlTemplate>
            <Grid Grid.Row="1"
                  RowDefinitions="Auto, *"
                  RowSpacing="8"
                  ColumnDefinitions="Auto, *"
                  BindingContext="{Binding Source={RelativeSource TemplatedParent}}">
                <Label WidthRequest="{OnPlatform Default=32, MacCatalyst=20}"
                       HeightRequest="{OnPlatform Default=32, MacCatalyst=20}"
                       FontFamily="{x:Static telerik:TelerikFont.Name}"
                       Text="{x:Static telerik:TelerikFont.IconSparkle}"
                       TextColor="{DynamicResource RadSubtleColor}"
                       Margin="{OnPlatform Default='0, 0, 0, 0', MacCatalyst='8, 0, 0, 0'}"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />
                <Label Grid.Column="1"
                       Text="Suggested Actions"
                       TextColor="{DynamicResource RadSubtleColor}"
                       FontSize="14"
                       FontAttributes="{OnPlatform Default='Bold', MacCatalyst='None'}"
                       VerticalTextAlignment="Center" />
                <Grid ColumnDefinitions="Auto, *, Auto"
                      Grid.Row="1"
                      Grid.ColumnSpan="2">
                    <telerik:RadTemplatedButton x:Name="PART_PreviousButton"
                                                Margin="{OnPlatform Default='0, 0, 2, 0', MacCatalyst='0, 0, 4, 0'}"
                                                Style="{StaticResource AIChatPreviousNavigationButtonStyle}" />
                    <example:AIChatSuggestionHostLayout Grid.Column="1"
                                                        IsClippedToBounds="True"
                                                        VerticalOptions="Center">
                        <example:AIChatSuggestionItemsLayout x:Name="PART_ItemsContainer"
                                                             IsClippedToBounds="False"
                                                             Spacing="4"
                                                             BindableLayout.ItemsSource="{TemplateBinding ItemsSource}"
                                                             BindableLayout.ItemTemplate="{StaticResource AIChatSuggestionItemTemplate}" />
                    </example:AIChatSuggestionHostLayout>
                    <telerik:RadTemplatedButton x:Name="PART_NextButton"
                                                Grid.Column="2"
                                                Margin="{OnPlatform Default='2, 0, 0, 0', MacCatalyst='4, 0, 0, 0'}"
                                                Style="{StaticResource AIChatNextNavigationButtonStyle}" />
                </Grid>
            </Grid>
        </ControlTemplate>
    </ContentView.ControlTemplate>
</ContentView>
