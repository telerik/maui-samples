<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:telerik="http://schemas.telerik.com/2022/xaml/maui"
             x:Class="QSF.Examples.EditorControl.FirstLookExample.FirstLookView">
    <ContentView.Resources>
        <ResourceDictionary>
            <Style TargetType="Label" BasedOn="{StaticResource BaseLabelStyle}" />

            <Style TargetType="VerticalStackLayout">
                <Setter Property="Spacing" Value="10" />
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>
    <ScrollView >
        <Grid RowDefinitions="{OnIdiom Default='Auto, Auto, Auto, Auto, Auto, *'}"
              RowSpacing="14"
              Margin="{OnIdiom Default='40, 20, 40, 0', Phone='40, 40, 40, 0'}"
              telerik:KeyboardHelper.IsTranslationTarget="True">
            <Label Text="Get in touch with us"
                   FontSize="{OnPlatform Default=24, MacCatalyst=22}"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   Margin="0, 0, 0, 16"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center" />

            <VerticalStackLayout Grid.Row="1">
                <Label Text="Your name"
                       FontSize="14" />
                <telerik:RadEntry Text="{Binding Name}" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="2">
                <Label Text="Email Address"
                       FontSize="14" />
                <telerik:RadEmailMaskedEntry Placeholder=" "
                                             Value="{Binding EmailAddress,Mode=TwoWay}" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="3">
                <Label Text="Subject"
                       FontSize="14" />
                <telerik:RadEntry Text="{Binding Subject}" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="4">
                <Label Text="Message"
                       FontSize="14" />
                <telerik:RadEditor Text="{Binding Message}"
                                   HeightRequest="108"
                                   telerik:KeyboardHelper.IsTranslationPivot="True"
                                   telerik:KeyboardHelper.IsTranslationSource="True"
                                   PropertyChanged="RadEditor_PropertyChanged" />
            </VerticalStackLayout>

            <telerik:RadTemplatedButton Grid.Row="5"
                                        Margin="{OnPlatform Default='0, 16, 0, 0', Android='0, 24, 0, 0'}"
                                        VerticalOptions="Start"
                                        HorizontalOptions="Start"
                                        Command="{Binding SendMessageCommand}"
                                        Content="Submit Message" />
        </Grid>
    </ScrollView>
</ContentView>
