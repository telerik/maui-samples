<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:telerik="http://schemas.telerik.com/2022/xaml/maui"
             x:Class="QSF.Examples.AIControl.A2UIExample.Views.BookingConfirmationView">

    <telerik:RadBorder CornerRadius="16"
                       BorderColor="{DynamicResource DefaultBorderColor}"
                       BorderThickness="1"
                       Background="{DynamicResource SecondaryBackgroundColor}"
                       Padding="24, 20">
        <VerticalStackLayout Spacing="14">
            <Label Text="✅ Booking Confirmed"
                   FontSize="20"
                   FontAttributes="Bold" />
            <Label Text="Your flight has been booked successfully. Here is a summary of your booking:"
                   FontSize="15"
                   LineHeight="1.3" />
            <VerticalStackLayout x:Name="resultList"
                                 Spacing="0"
                                 Margin="0, 6, 0, 0" />
        </VerticalStackLayout>
    </telerik:RadBorder>
</ContentView>
