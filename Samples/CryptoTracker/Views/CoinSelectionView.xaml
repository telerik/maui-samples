<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:telerik="http://schemas.telerik.com/2022/xaml/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:CryptoTracker.ViewModels"
             x:Class="CryptoTracker.Views.CoinSelectionView"
             x:Name="mainView"
             BackgroundColor="AliceBlue">

    <ContentView.BindingContext>
        <local:CoinSelectionViewModel />
    </ContentView.BindingContext>

    <telerik:RadBusyIndicator x:Name="BusyIndicator"
                              IsBusy="{Binding IsDataLoading}"
                              Style="{StaticResource DefaultBusyIndicatorStyle}">
        <telerik:RadBusyIndicator.BusyContent>
            <Label Text="Loading Data" HorizontalOptions="Center" HeightRequest="60" />
        </telerik:RadBusyIndicator.BusyContent>
        <Grid RowDefinitions="Auto, *" RowSpacing="20">
            <telerik:RadBorder Style="{StaticResource CollectionViewBorderWrapStyle}"
                               Padding="20, 10" MinimumHeightRequest="155">
                <telerik:RadCollectionView ItemTapped="OnTrendingCollectionViewItemTapped"
                                           SelectionMode="None"
                                           x:Name="trendingCollectionView"
                                           ItemsSource="{Binding TrendingCoins}"
                                           ItemViewStyle="{StaticResource TrendingCollectionViewItemStyle}">
                    <telerik:RadCollectionView.HeaderTemplate>
                        <DataTemplate x:Key="HeaderTemplate">
                            <Grid>
                                <Label Text="Trending" Style="{StaticResource TrendingTitleStyle}" Padding="0, 12"/>
                            </Grid>
                        </DataTemplate>
                    </telerik:RadCollectionView.HeaderTemplate>
                    <telerik:RadCollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto, Auto, *, Auto" RowDefinitions="Auto, *" >
                                <Label Style="{StaticResource TrendingCoinsCounterStyle}" Text="{Binding ListNumber}"/>
                                <Label Grid.Column="1" Style="{StaticResource TrendingCoinSymbolStyle}" Text="{Binding Data.Symbol}"/>
                                <Label Grid.Column="2" Style="{StaticResource TrendingCoinNameStyle}" Text="{Binding Data.Name}"/>
                                <Label Grid.Column="3" Style="{StaticResource TrendingCoinPercentage}" Text="{Binding Data.ChangeInPricePercentage, StringFormat='{0:+0.00;- 0.00;0.00}%'}"/>
                            </Grid>
                        </DataTemplate>
                    </telerik:RadCollectionView.ItemTemplate>
                    <telerik:RadCollectionView.ItemsLayout>
                        <telerik:CollectionViewLinearLayout ItemLength="40" ItemSpacing="2" />
                    </telerik:RadCollectionView.ItemsLayout>
                </telerik:RadCollectionView>
            </telerik:RadBorder>

            <telerik:RadBorder Grid.Row="1" Style="{StaticResource CollectionViewBorderWrapStyle}">
                <telerik:RadCollectionView ItemTapped="OnCollectionViewItemTapped"
                                           SelectionMode="{OnIdiom Default=Single, Phone=None}"
                                           x:Name="collectionView"
                                           ItemsSource="{Binding Source}"
                                           ItemViewStyle="{StaticResource CollectionViewItemStyle}">
                    <telerik:RadCollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto, *, Auto, Auto" >
                                <Label Style="{StaticResource CollectionViewCoinSymbolStyle}" Text="{Binding Symbol}"/>
                                <Label Grid.Column="1" Style="{StaticResource CollectionViewCoinNameStyle}" Text="{Binding Name}"/>
                                <VerticalStackLayout Spacing="2" Grid.Column="2"
                                                     VerticalOptions="Center">
                                    <Label HorizontalTextAlignment="End" Style="{StaticResource CollectionViewCoinPriceStyle}" Text="{Binding OpeningPrice, StringFormat='${0:N2}'}"/>
                                    <Label HorizontalTextAlignment="End" FontSize="14" TextColor="{Binding ChangeInPriceAmount, Converter={StaticResource ValueToColorConverter}}">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0:+0.00;- 0.00;0.00} ({1:0.00;0.00;0.00}%)">
                                                <Binding Path="ChangeInPriceAmount"/>
                                                <Binding Path="ChangeInPricePercentage"/>
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                </VerticalStackLayout>
                                <Image Grid.Column="3"
                                       Source="arrowright.png"
                                       Margin="20, 0"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       WidthRequest="24"
                                       HeightRequest="24" />
                            </Grid>
                        </DataTemplate>
                    </telerik:RadCollectionView.ItemTemplate>
                    <telerik:RadCollectionView.ItemsLayout>
                        <telerik:CollectionViewLinearLayout ItemLength="54" ItemSpacing="2" />
                    </telerik:RadCollectionView.ItemsLayout>
                </telerik:RadCollectionView>
            </telerik:RadBorder>
        </Grid>
    </telerik:RadBusyIndicator>
</ContentView>
